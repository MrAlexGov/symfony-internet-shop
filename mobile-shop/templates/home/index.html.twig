{% extends 'base.html.twig' %}

{% block title %}Mobile Shop - Интернет-магазин мобильных телефонов{% endblock %}

{% block body %}
    <!-- Hero Section -->
    <div class="jumbotron bg-primary text-white rounded-3 mb-5" id="about">
        <div class="container py-5">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <h1 class="display-4 fw-bold">
                        <i class="fas fa-mobile-alt me-3"></i>
                        Mobile Shop
                    </h1>
                    <p class="lead">
                        Лучший выбор мобильных телефонов и аксессуаров по выгодным ценам.
                        Оригинальная продукция с гарантией качества.
                    </p>
                    <div class="d-flex gap-2 mb-3">
                        <a href="{{ path('app_catalog') }}" class="btn btn-light btn-lg">
                            <i class="fas fa-shopping-bag me-2"></i>
                            Перейти к покупкам
                        </a>
                        {% if app.user %}
                            <div class="btn-group">
                                <button class="btn btn-outline-light btn-lg dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-star me-2"></i>
                                    Быстрые действия
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="{{ path('app_cart') }}">
                                        <i class="fas fa-shopping-cart me-2"></i>Корзина
                                        {% if app.user.cart and not app.user.cart.isEmpty %}
                                            <span class="badge bg-primary ms-2">{{ app.user.cart.totalItems }}</span>
                                        {% endif %}
                                    </a></li>
                                    <li><a class="dropdown-item" href="{{ path('app_wishlist') }}">
                                        <i class="fas fa-heart me-2"></i>Избранное
                                        {% if app.user.wishlist and not app.user.wishlist.isEmpty %}
                                            <span class="badge bg-danger ms-2">{{ app.user.wishlist.totalItems }}</span>
                                        {% endif %}
                                    </a></li>
                                    <li><a class="dropdown-item" href="{{ path('app_compare') }}">
                                        <i class="fas fa-balance-scale me-2"></i>Сравнение
                                        {% if app.user.compare and not app.user.compare.isEmpty %}
                                            <span class="badge bg-info ms-2">{{ app.user.compare.totalItems }}</span>
                                        {% endif %}
                                    </a></li>
                                </ul>
                            </div>
                        {% endif %}
                    </div>
                </div>
                <div class="col-lg-6">
                    <img src="{{ asset('images/phones-hero.png') }}"
                         alt="Мобильные телефоны"
                         class="img-fluid rounded">
                </div>
            </div>
        </div>
    </div>

    <!-- Features Section -->
    <div class="row mb-5" id="catalog">
        <div class="col-md-4 text-center mb-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <i class="fas fa-shield-alt fa-3x text-primary mb-3"></i>
                    <h5 class="card-title">Гарантия качества</h5>
                    <p class="card-text">
                        Все товары проходят строгий контроль качества и имеют официальную гарантию производителя.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 text-center mb-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <i class="fas fa-truck fa-3x text-success mb-3"></i>
                    <h5 class="card-title">Быстрая доставка</h5>
                    <p class="card-text">
                        Доставляем заказы по Москве в день оформления и по России в течение 1-3 дней.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 text-center mb-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <i class="fas fa-headset fa-3x text-info mb-3"></i>
                    <h5 class="card-title">Поддержка 24/7</h5>
                    <p class="card-text">
                        Наша служба поддержки готова помочь вам в любое время суток по телефону или онлайн.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Popular Categories -->
    <div class="row mb-5">
        <div class="col-12">
            <h2 class="text-center mb-4">
                <i class="fas fa-th-large text-primary me-2"></i>
                Популярные категории
            </h2>
        </div>
    </div>

    <div class="row">
        {% for category in popular_categories %}
            <div class="col-md-3 mb-4">
                <a href="{{ path('app_catalog_category', {'slug': category.slug}) }}" class="text-decoration-none">
                    <div class="card category-card h-100">
                        <div class="card-body text-center">
                            {% if category.icon %}
                                <i class="{{ category.icon }} fa-4x text-primary mb-3"></i>
                            {% else %}
                                <i class="fas fa-mobile-alt fa-4x text-primary mb-3"></i>
                            {% endif %}
                            <h6 class="card-title">{{ category.name }}</h6>
                            {% if category.description %}
                                <p class="card-text text-muted">{{ category.description|length > 50 ? category.description|slice(0, 50) ~ '...' : category.description }}</p>
                            {% endif %}
                        </div>
                    </div>
                </a>
            </div>
        {% endfor %}
    </div>

    <!-- Featured Products -->
    <div class="row mb-5">
        <div class="col-12">
            <h2 class="text-center mb-4">
                <i class="fas fa-star text-warning me-2"></i>
                Рекомендуемые товары
            </h2>
        </div>
    </div>

    <div class="row">
        {% for product in featured_products %}
            <div class="col-md-3 mb-4">
                <div class="card product-card h-100">
                    <div class="product-image">
                        {% if product.mainImage %}
                            <img src="{{ asset('uploads/products/' ~ product.mainImage) }}"
                                 class="card-img-top"
                                 alt="{{ product.name }}"
                                 onerror="this.src='{{ asset('images/error-placeholder.png') }}'">
                        {% else %}
                            <img src="{{ asset('images/no-photo.png') }}"
                                 class="card-img-top"
                                 alt="{{ product.name }}"
                                 onerror="this.src='{{ asset('images/error-placeholder.png') }}'">
                        {% endif %}
                        {% if product.isFeatured %}
                            <div class="featured-badge">
                                <span class="badge bg-warning">
                                    <i class="fas fa-star me-1"></i>Хит
                                </span>
                            </div>
                        {% endif %}
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title">{{ product.name }}</h6>
                        <p class="card-text text-muted flex-grow-1">
                            {{ product.brand.name }} • {{ product.category.name }}
                        </p>
                        {% if product.shortDescription %}
                            <p class="card-text small text-muted mb-2">
                                {{ product.shortDescription|length > 60 ? product.shortDescription|slice(0, 60) ~ '...' : product.shortDescription }}
                            </p>
                        {% endif %}
                        <div class="product-price mb-2">
                            <span class="price fs-5 fw-bold text-primary">{{ product.price }} ₽</span>
                            {% if product.oldPrice %}
                                <span class="old-price text-muted text-decoration-line-through ms-2">
                                    {{ product.oldPrice }} ₽
                                </span>
                            {% endif %}
                        </div>
                        <div class="product-actions mt-auto">
                            <a href="{{ path('app_product_show', {'slug': product.slug}) }}"
                               class="btn btn-outline-primary btn-sm me-2">
                                <i class="fas fa-eye me-1"></i>
                                Подробнее
                            </a>
                            <button class="btn btn-primary btn-sm">
                                <i class="fas fa-shopping-cart me-1"></i>
                                В корзину
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <!-- Newsletter Section -->
    <div class="row mt-5" id="contacts">
        <div class="col-12">
            <div class="bg-light rounded-3 p-5 text-center">
                <h3>
                    <i class="fas fa-envelope text-primary me-2"></i>
                    Подпишитесь на новости
                </h3>
                <p class="text-muted mb-4">
                    Получайте информацию о новинках и специальных предложениях первыми!
                </p>
                <div class="row justify-content-center">
                    <div class="col-md-6">
                        <form class="d-flex">
                            <input type="email"
                                   class="form-control me-2"
                                   placeholder="Введите ваш email">
                            <button type="submit" class="btn btn-primary">
                                Подписаться
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    <style>
        .jumbotron {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .category-card {
            transition: transform 0.3s ease;
            cursor: pointer;
        }

        .category-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .product-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            cursor: pointer;
        }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        }

        .product-image {
            height: 200px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #f8f9fa;
        }

        .product-price .price {
            font-size: 1.25rem;
            font-weight: bold;
            color: #007bff;
        }

        .product-price .old-price {
            font-size: 0.9rem;
        }

        .featured-badge {
            position: absolute;
            top: 10px;
            left: 10px;
        }

        .product-actions .btn {
            flex: 1;
        }
    </style>
{% endblock %}
