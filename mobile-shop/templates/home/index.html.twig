{% extends 'base.html.twig' %}

{% block title %}Mobile Shop - Интернет-магазин мобильных телефонов{% endblock %}

{% block body %}
    <!-- Hero Section -->
    <div class="jumbotron bg-primary text-white rounded-3 mb-5">
        <div class="container py-5">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <h1 class="display-4 fw-bold">
                        <i class="fas fa-mobile-alt me-3"></i>
                        Mobile Shop
                    </h1>
                    <p class="lead">
                        Лучший выбор мобильных телефонов и аксессуаров по выгодным ценам.
                        Оригинальная продукция с гарантией качества.
                    </p>
                    <a href="#catalog" class="btn btn-light btn-lg">
                        <i class="fas fa-shopping-bag me-2"></i>
                        Перейти к покупкам
                    </a>
                </div>
                <div class="col-lg-6">
                    <img src="https://via.placeholder.com/600x400/007bff/ffffff?text=%D0%9C%D0%BE%D0%B1%D0%B8%D0%BB%D1%8C%D0%BD%D1%8B%D0%B5+%D1%82%D0%B5%D0%BB%D0%B5%D1%84%D0%BE%D0%BD%D1%8B"
                         alt="Мобильные телефоны"
                         class="img-fluid rounded">
                </div>
            </div>
        </div>
    </div>

    <!-- Features Section -->
    <div class="row mb-5" id="catalog">
        <div class="col-md-4 text-center mb-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <i class="fas fa-shield-alt fa-3x text-primary mb-3"></i>
                    <h5 class="card-title">Гарантия качества</h5>
                    <p class="card-text">
                        Все товары проходят строгий контроль качества и имеют официальную гарантию производителя.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 text-center mb-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <i class="fas fa-truck fa-3x text-success mb-3"></i>
                    <h5 class="card-title">Быстрая доставка</h5>
                    <p class="card-text">
                        Доставляем заказы по Москве в день оформления и по России в течение 1-3 дней.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 text-center mb-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <i class="fas fa-headset fa-3x text-info mb-3"></i>
                    <h5 class="card-title">Поддержка 24/7</h5>
                    <p class="card-text">
                        Наша служба поддержки готова помочь вам в любое время суток по телефону или онлайн.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Popular Categories -->
    <div class="row mb-5">
        <div class="col-12">
            <h2 class="text-center mb-4">
                <i class="fas fa-th-large text-primary me-2"></i>
                Популярные категории
            </h2>
        </div>
    </div>

    <div class="row">
        <div class="col-md-3 mb-4">
            <div class="card category-card">
                <div class="card-body text-center">
                    <i class="fab fa-apple fa-4x text-secondary mb-3"></i>
                    <h6 class="card-title">iPhone</h6>
                    <p class="card-text text-muted">Смартфоны Apple</p>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card category-card">
                <div class="card-body text-center">
                    <i class="fas fa-mobile-alt fa-4x text-success mb-3"></i>
                    <h6 class="card-title">Android</h6>
                    <p class="card-text text-muted">Смартфоны на Android</p>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card category-card">
                <div class="card-body text-center">
                    <i class="fas fa-headphones fa-4x text-warning mb-3"></i>
                    <h6 class="card-title">Аксессуары</h6>
                    <p class="card-text text-muted">Чехлы, наушники, зарядки</p>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card category-card">
                <div class="card-body text-center">
                    <i class="fas fa-battery-half fa-4x text-danger mb-3"></i>
                    <h6 class="card-title">Аккумуляторы</h6>
                    <p class="card-text text-muted">Внешние батареи и зарядки</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Featured Products -->
    <div class="row mb-5">
        <div class="col-12">
            <h2 class="text-center mb-4">
                <i class="fas fa-star text-warning me-2"></i>
                Рекомендуемые товары
            </h2>
        </div>
    </div>

    <div class="row">
        {% for i in 1..4 %}
            <div class="col-md-3 mb-4">
                <div class="card product-card h-100">
                    <div class="product-image">
                        <img src="https://via.placeholder.com/300x300/e9ecef/6c757d?text=%D0%A2%D0%B5%D0%BB%D0%B5%D1%84%D0%BE%D0%BD+{{ i }}"
                             class="card-img-top"
                             alt="Телефон {{ i }}">
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title">Смартфон {{ i }}</h6>
                        <p class="card-text text-muted flex-grow-1">
                            Отличный смартфон с современными характеристиками
                        </p>
                        <div class="product-price">
                            <span class="price">₽45,990</span>
                        </div>
                        <button class="btn btn-primary mt-2">
                            <i class="fas fa-shopping-cart me-2"></i>
                            В корзину
                        </button>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <!-- Newsletter Section -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="bg-light rounded-3 p-5 text-center">
                <h3>
                    <i class="fas fa-envelope text-primary me-2"></i>
                    Подпишитесь на новости
                </h3>
                <p class="text-muted mb-4">
                    Получайте информацию о новинках и специальных предложениях первыми!
                </p>
                <div class="row justify-content-center">
                    <div class="col-md-6">
                        <form class="d-flex">
                            <input type="email"
                                   class="form-control me-2"
                                   placeholder="Введите ваш email">
                            <button type="submit" class="btn btn-primary">
                                Подписаться
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    <style>
        .jumbotron {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .category-card {
            transition: transform 0.3s ease;
            cursor: pointer;
        }

        .category-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .product-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            cursor: pointer;
        }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        }

        .product-image {
            height: 200px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #f8f9fa;
        }

        .product-price .price {
            font-size: 1.25rem;
            font-weight: bold;
            color: #dc3545;
        }
    </style>
{% endblock %}
