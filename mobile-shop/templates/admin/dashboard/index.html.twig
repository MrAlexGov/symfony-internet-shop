{% extends 'base.html.twig' %}

{% block title %}Админ панель - Mobile Shop{% endblock %}

{% block body %}
    <!-- Навигационная панель админки -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container-fluid">
            <a class="navbar-brand" href="{{ path('app_admin_dashboard') }}">
                <i class="fas fa-cog me-2"></i>Админ панель
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="adminNavbar">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link active" href="{{ path('app_admin_dashboard') }}">
                            <i class="fas fa-tachometer-alt me-1"></i>Дашборд
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="fas fa-box me-1"></i>Товары
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="fas fa-shopping-cart me-1"></i>Заказы
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="fas fa-users me-1"></i>Пользователи
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="fas fa-chart-bar me-1"></i>Отчеты
                        </a>
                    </li>
                </ul>

                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_home') }}">
                            <i class="fas fa-arrow-left me-1"></i>На сайт
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <!-- Заголовок -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>
                <i class="fas fa-tachometer-alt text-primary me-3"></i>
                Дашборд аналитики
            </h1>
            <div class="text-muted">
                <i class="fas fa-calendar me-2"></i>
                {{ "now"|date("d.m.Y H:i") }}
            </div>
        </div>

        <!-- Карточки статистики -->
        <div class="row mb-4">
            <div class="col-md-3 mb-3">
                <div class="card bg-primary text-white h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-users fa-3x mb-3"></i>
                        <h3 class="card-title">{{ totalUsers }}</h3>
                        <p class="card-text">Всего пользователей</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card bg-success text-white h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-box fa-3x mb-3"></i>
                        <h3 class="card-title">{{ totalProducts }}</h3>
                        <p class="card-text">Активных товаров</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card bg-warning text-white h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-shopping-cart fa-3x mb-3"></i>
                        <h3 class="card-title">0</h3>
                        <p class="card-text">Заказов сегодня</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card bg-info text-white h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-ruble-sign fa-3x mb-3"></i>
                        <h3 class="card-title">0 ₽</h3>
                        <p class="card-text">Выручка сегодня</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Недавние пользователи -->
            <div class="col-md-6 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-users text-primary me-2"></i>
                            Недавние пользователи
                        </h5>
                    </div>
                    <div class="card-body">
                        {% if recentUsers is defined and recentUsers|length > 0 %}
                            <div class="list-group list-group-flush">
                                {% for user in recentUsers %}
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong>{{ user.getFullName() }}</strong>
                                            <br>
                                            <small class="text-muted">{{ user.email }}</small>
                                        </div>
                                        <small class="text-muted">
                                            {{ user.createdAt|date('d.m.Y') }}
                                        </small>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <p class="text-muted mb-0">Пользователи не найдены</p>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Товары с низким остатком -->
            <div class="col-md-6 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-exclamation-triangle text-warning me-2"></i>
                            Товары с низким остатком
                        </h5>
                    </div>
                    <div class="card-body">
                        {% if lowStockProducts is defined and lowStockProducts|length > 0 %}
                            <div class="list-group list-group-flush">
                                {% for product in lowStockProducts %}
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong>{{ product.name }}</strong>
                                            <br>
                                            <small class="text-muted">{{ product.sku }}</small>
                                        </div>
                                        <span class="badge {% if product.stock == 0 %}bg-danger{% else %}bg-warning{% endif %}">
                                            {{ product.stock }} шт.
                                        </span>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <p class="text-muted mb-0">
                                <i class="fas fa-check-circle text-success me-2"></i>
                                Все товары в наличии
                            </p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <!-- Графики и диаграммы (заглушки для будущих улучшений) -->
        <div class="row">
            <div class="col-md-8 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-chart-line text-primary me-2"></i>
                            Продажи за неделю
                        </h5>
                    </div>
                    <div class="card-body">
                        <canvas id="salesChart" width="400" height="200"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-pie-chart text-info me-2"></i>
                            Топ категорий
                        </h5>
                    </div>
                    <div class="card-body">
                        <canvas id="categoriesChart" width="400" height="200"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts_bottom %}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Заглушка для графика продаж
        const salesCtx = document.getElementById('salesChart').getContext('2d');
        new Chart(salesCtx, {
            type: 'line',
            data: {
                labels: ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'],
                datasets: [{
                    label: 'Продажи',
                    data: [12, 19, 3, 5, 2, 3, 7],
                    borderColor: 'rgb(75, 192, 192)',
                    tension: 0.1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        });

        // Заглушка для диаграммы категорий
        const categoriesCtx = document.getElementById('categoriesChart').getContext('2d');
        new Chart(categoriesCtx, {
            type: 'doughnut',
            data: {
                labels: ['Смартфоны', 'Аксессуары', 'Чехлы'],
                datasets: [{
                    data: [40, 35, 25],
                    backgroundColor: [
                        'rgb(255, 99, 132)',
                        'rgb(54, 162, 235)',
                        'rgb(255, 205, 86)'
                    ]
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        });
    </script>
{% endblock %}

{% block stylesheets %}
    <style>
        .card {
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            transition: transform 0.2s ease-in-out;
        }

        .card:hover {
            transform: translateY(-2px);
        }

        .navbar-brand {
            font-weight: bold;
        }

        .stat-card {
            background: linear-gradient(45deg, var(--bs-primary), #0056b3);
        }
    </style>
{% endblock %}
