{% extends 'base.html.twig' %}

{% block title %}{{ category.name }} - Mobile Shop{% endblock %}

{% block body %}
    <div class="row">
        <!-- Хлебные крошки -->
        <div class="col-12 mb-4">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="{{ path('app_home') }}">
                            <i class="fas fa-home me-1"></i>Главная
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="{{ path('app_catalog') }}">Каталог</a>
                    </li>
                    <li class="breadcrumb-item active">{{ category.name }}</li>
                </ol>
            </nav>
        </div>

        <!-- Заголовок категории -->
        <div class="col-12 mb-4">
            <div class="category-header p-4 bg-light rounded">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h1 class="mb-2">
                            {% if category.icon %}
                                <i class="{{ category.icon }} text-primary me-2"></i>
                            {% endif %}
                            {{ category.name }}
                        </h1>
                        {% if category.description %}
                            <p class="text-muted mb-0">{{ category.description }}</p>
                        {% endif %}
                    </div>
                    <div class="col-md-4 text-md-end">
                        <span class="badge bg-primary fs-6">{{ products|length }} товаров</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Список товаров категории -->
        <div class="col-12">
            {% if products|length > 0 %}
                <div class="row">
                    {% for product in products %}
                        <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                            <div class="card product-card h-100">
                                <div class="product-image">
                                    {% if product.mainImage %}
                                        <img src="{{ asset('uploads/products/' ~ product.mainImage) }}"
                                             class="card-img-top"
                                             alt="{{ product.name }}"
                                             onerror="this.src='https://via.placeholder.com/300x300/e9ecef/6c757d?text=%D0%9E%D1%88%D0%B8%D0%B1%D0%BA%D0%B0'">
                                    {% else %}
                                        <img src="https://via.placeholder.com/300x300/e9ecef/6c757d?text=%D0%9D%D0%B5%D1%82+%D1%84%D0%BE%D1%82%D0%BE"
                                             class="card-img-top"
                                             alt="{{ product.name }}"
                                             onerror="this.src='https://via.placeholder.com/300x300/e9ecef/6c757d?text=%D0%9E%D1%88%D0%B8%D0%B1%D0%BA%D0%B0'">
                                    {% endif %}
                                    {% if product.isFeatured %}
                                        <div class="featured-badge">
                                            <span class="badge bg-warning">
                                                <i class="fas fa-star me-1"></i>Хит
                                            </span>
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="card-body d-flex flex-column">
                                    <h6 class="card-title">{{ product.name }}</h6>
                                    <p class="card-text text-muted flex-grow-1">
                                        {{ product.brand.name }}
                                    </p>

                                    {% if product.shortDescription %}
                                        <p class="card-text small text-muted mb-2">
                                            {{ product.shortDescription|length > 60 ? product.shortDescription|slice(0, 60) ~ '...' : product.shortDescription }}
                                        </p>
                                    {% endif %}

                                    <div class="product-price mb-2">
                                        <span class="price fs-5 fw-bold text-primary">{{ product.price }} ₽</span>
                                        {% if product.oldPrice %}
                                            <span class="old-price text-muted text-decoration-line-through ms-2">
                                                {{ product.oldPrice }} ₽
                                            </span>
                                        {% endif %}
                                    </div>

                                    <div class="product-actions mt-auto">
                                        <a href="{{ path('app_product_show', {'slug': product.slug}) }}"
                                           class="btn btn-outline-primary btn-sm me-2">
                                            <i class="fas fa-eye me-1"></i>
                                            Подробнее
                                        </a>
                                        <button class="btn btn-primary btn-sm">
                                            <i class="fas fa-shopping-cart me-1"></i>
                                            В корзину
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="text-center py-5">
                    <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">Товары не найдены</h4>
                    <p class="text-muted">В данной категории пока нет товаров</p>
                    <a href="{{ path('app_catalog') }}" class="btn btn-primary">
                        <i class="fas fa-list me-2"></i>
                        Перейти к каталогу
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    <style>
        .product-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            cursor: pointer;
        }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        }

        .product-image {
            height: 200px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #f8f9fa;
            position: relative;
        }

        .product-image img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        .featured-badge {
            position: absolute;
            top: 10px;
            left: 10px;
        }

        .product-price .price {
            font-size: 1.25rem;
        }

        .product-price .old-price {
            font-size: 0.9rem;
        }

        .category-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .category-header .text-muted {
            color: rgba(255, 255, 255, 0.8) !important;
        }

        .breadcrumb {
            background-color: #f8f9fa;
            border-radius: 0.375rem;
        }
    </style>
{% endblock %}