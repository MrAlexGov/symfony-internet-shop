{% extends 'base.html.twig' %}

{% block title %}Каталог товаров - Mobile Shop{% endblock %}

{% block body %}
    <div class="row">
        <!-- Фильтры (сайдбар) -->
        <div class="col-lg-3">
            {% if app.user %}
                <!-- Панель быстрого доступа -->
                <div class="card mb-4">
                    <div class="card-header bg-info text-white">
                        <h6 class="mb-0">
                            <i class="fas fa-tachometer-alt me-2"></i>
                            Быстрый доступ
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <a href="{{ path('app_cart') }}" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-shopping-cart me-2"></i>
                                Корзина
                                {% if app.user.cart and not app.user.cart.isEmpty %}
                                    <span class="badge bg-primary ms-2">{{ app.user.cart.totalItems }}</span>
                                {% endif %}
                            </a>
                            <a href="{{ path('app_wishlist') }}" class="btn btn-outline-danger btn-sm">
                                <i class="fas fa-heart me-2"></i>
                                Избранное
                                {% if app.user.wishlist and not app.user.wishlist.isEmpty %}
                                    <span class="badge bg-danger ms-2">{{ app.user.wishlist.totalItems }}</span>
                                {% endif %}
                            </a>
                            <a href="{{ path('app_compare') }}" class="btn btn-outline-info btn-sm">
                                <i class="fas fa-balance-scale me-2"></i>
                                Сравнение
                                {% if app.user.compare and not app.user.compare.isEmpty %}
                                    <span class="badge bg-info ms-2">{{ app.user.compare.totalItems }}</span>
                                {% endif %}
                            </a>
                        </div>
                    </div>
                </div>
            {% endif %}
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-filter me-2"></i>
                        Фильтры
                    </h5>
                </div>
                <div class="card-body">
                    <form method="get" action="{{ path('app_catalog') }}">
                        <!-- Поиск -->
                        <div class="mb-3">
                            <label for="search" class="form-label">
                                <i class="fas fa-search me-2"></i>Поиск
                            </label>
                            <input type="text"
                                   class="form-control"
                                   id="search"
                                   name="search"
                                   value="{{ currentSearch }}"
                                   placeholder="Название, модель...">
                        </div>

                        <!-- Категория -->
                        <div class="mb-3">
                            <label for="category" class="form-label">
                                <i class="fas fa-th-large me-2"></i>Категория
                            </label>
                            <select class="form-select" id="category" name="category">
                                <option value="">Все категории</option>
                                {% for category in categories %}
                                    <option value="{{ category.id }}" {% if currentCategory == category.id %}selected{% endif %}>
                                        {{ category.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <!-- Бренд -->
                        <div class="mb-3">
                            <label for="brand" class="form-label">
                                <i class="fas fa-tags me-2"></i>Бренд
                            </label>
                            <select class="form-select" id="brand" name="brand">
                                <option value="">Все бренды</option>
                                {% for brand in brands %}
                                    <option value="{{ brand.id }}" {% if currentBrand == brand.id %}selected{% endif %}>
                                        {{ brand.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <!-- Цена -->
                        <div class="mb-3">
                            <label class="form-label">
                                <i class="fas fa-ruble-sign me-2"></i>Цена
                            </label>
                            <div class="row">
                                <div class="col-6">
                                    <input type="number"
                                           class="form-control"
                                           name="min_price"
                                           value="{{ currentMinPrice }}"
                                           placeholder="От">
                                </div>
                                <div class="col-6">
                                    <input type="number"
                                           class="form-control"
                                           name="max_price"
                                           value="{{ currentMaxPrice }}"
                                           placeholder="До">
                                </div>
                            </div>
                        </div>

                        <!-- Сортировка -->
                        <div class="mb-3">
                            <label for="sort" class="form-label">
                                <i class="fas fa-sort me-2"></i>Сортировка
                            </label>
                            <select class="form-select" id="sort" name="sort">
                                <option value="name" {% if currentSort == 'name' %}selected{% endif %}>
                                    По названию
                                </option>
                                <option value="price" {% if currentSort == 'price' %}selected{% endif %}>
                                    По цене
                                </option>
                                <option value="createdAt" {% if currentSort == 'createdAt' %}selected{% endif %}>
                                    По новизне
                                </option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <select class="form-select" name="order">
                                <option value="ASC" {% if currentOrder == 'ASC' %}selected{% endif %}>
                                    По возрастанию
                                </option>
                                <option value="DESC" {% if currentOrder == 'DESC' %}selected{% endif %}>
                                    По убыванию
                                </option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-search me-2"></i>
                            Применить фильтры
                        </button>

                        <a href="{{ path('app_catalog') }}" class="btn btn-outline-secondary w-100 mt-2">
                            <i class="fas fa-times me-2"></i>
                            Сбросить
                        </a>
                    </form>
                </div>
            </div>
        </div>

        <!-- Список товаров -->
        <div class="col-lg-9">
            <!-- Заголовок и количество товаров -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>
                    <i class="fas fa-mobile-alt text-primary me-2"></i>
                    Каталог товаров
                    {% if products.getTotalItemCount > 0 %}
                        <small class="text-muted">({{ products.getTotalItemCount }})</small>
                    {% endif %}
                </h2>
            </div>

            {% if products|length > 0 %}
                <!-- Тулбар сортировки -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="fas fa-sort me-2"></i>
                            Сортировка
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item {% if currentSort == 'name' and currentOrder == 'ASC' %}active{% endif %}"
                                   href="?{% if currentSearch %}search={{ currentSearch }}&{% endif %}{% if currentCategory %}category={{ currentCategory }}&{% endif %}{% if currentBrand %}brand={{ currentBrand }}&{% endif %}{% if currentMinPrice %}min_price={{ currentMinPrice }}&{% endif %}{% if currentMaxPrice %}max_price={{ currentMaxPrice }}&{% endif %}sort=name&order=ASC">
                                    По названию (А-Я)
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item {% if currentSort == 'name' and currentOrder == 'DESC' %}active{% endif %}"
                                   href="?{% if currentSearch %}search={{ currentSearch }}&{% endif %}{% if currentCategory %}category={{ currentCategory }}&{% endif %}{% if currentBrand %}brand={{ currentBrand }}&{% endif %}{% if currentMinPrice %}min_price={{ currentMinPrice }}&{% endif %}{% if currentMaxPrice %}max_price={{ currentMaxPrice }}&{% endif %}sort=name&order=DESC">
                                    По названию (Я-А)
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item {% if currentSort == 'price' and currentOrder == 'ASC' %}active{% endif %}"
                                   href="?{% if currentSearch %}search={{ currentSearch }}&{% endif %}{% if currentCategory %}category={{ currentCategory }}&{% endif %}{% if currentBrand %}brand={{ currentBrand }}&{% endif %}{% if currentMinPrice %}min_price={{ currentMinPrice }}&{% endif %}{% if currentMaxPrice %}max_price={{ currentMaxPrice }}&{% endif %}sort=price&order=ASC">
                                    Цена: по возрастанию
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item {% if currentSort == 'price' and currentOrder == 'DESC' %}active{% endif %}"
                                   href="?{% if currentSearch %}search={{ currentSearch }}&{% endif %}{% if currentCategory %}category={{ currentCategory }}&{% endif %}{% if currentBrand %}brand={{ currentBrand }}&{% endif %}{% if currentMinPrice %}min_price={{ currentMinPrice }}&{% endif %}{% if currentMaxPrice %}max_price={{ currentMaxPrice }}&{% endif %}sort=price&order=DESC">
                                    Цена: по убыванию
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Сетка товаров -->
                <div class="row">
                    {% for product in products.items %}
                        <div class="col-md-4 mb-4">
                            <div class="card product-card h-100">
                                <div class="product-image">
                                    {% if product.mainImage %}
                                        <img src="{{ asset('uploads/products/' ~ product.mainImage) }}"
                                             class="card-img-top"
                                             alt="{{ product.name }}">
                                    {% else %}
                                        <img src="https://via.placeholder.com/300x300/e9ecef/6c757d?text=%D0%9D%D0%B5%D1%82+%D1%84%D0%BE%D1%82%D0%BE"
                                             class="card-img-top"
                                             alt="{{ product.name }}"
                                             onerror="this.src='https://via.placeholder.com/300x300/e9ecef/6c757d?text=%D0%9E%D1%88%D0%B8%D0%B1%D0%BA%D0%B0'">
                                    {% endif %}
                                    {% if product.isFeatured %}
                                        <div class="featured-badge">
                                            <span class="badge bg-warning">
                                                <i class="fas fa-star me-1"></i>Хит
                                            </span>
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="card-body d-flex flex-column">
                                    <h6 class="card-title">{{ product.name }}</h6>
                                    <p class="card-text text-muted flex-grow-1">
                                        {{ product.brand.name }} • {{ product.category.name }}
                                    </p>

                                    {% if product.shortDescription %}
                                        <p class="card-text small text-muted mb-2">
                                            {{ product.shortDescription|length > 60 ? product.shortDescription|slice(0, 60) ~ '...' : product.shortDescription }}
                                        </p>
                                    {% endif %}

                                    <div class="product-price mb-2">
                                        <span class="price fs-5 fw-bold text-primary">{{ product.price }} ₽</span>
                                        {% if product.oldPrice %}
                                            <span class="old-price text-muted text-decoration-line-through ms-2">
                                                {{ product.oldPrice }} ₽
                                            </span>
                                        {% endif %}
                                    </div>

                                    <div class="product-actions mt-auto">
                                        <div class="btn-group w-100 mb-2" role="group">
                                            <a href="{{ path('app_product_show', {'slug': product.slug}) }}"
                                               class="btn btn-outline-primary btn-sm">
                                                <i class="fas fa-eye me-1"></i>
                                                Подробнее
                                            </a>
                                            {% if app.user %}
                                                <button class="btn btn-outline-danger btn-sm" onclick="toggleWishlist({{ product.id }})">
                                                    <i class="far fa-heart"></i>
                                                </button>
                                                <button class="btn btn-outline-info btn-sm" onclick="toggleCompare({{ product.id }})">
                                                    <i class="fas fa-balance-scale"></i>
                                                </button>
                                            {% endif %}
                                        </div>
                                        <button class="btn btn-primary w-100" onclick="addToCart({{ product.id }})">
                                            <i class="fas fa-shopping-cart me-1"></i>
                                            В корзину
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <!-- Пагинация -->
                {% if products.pageCount > 1 %}
                    <div class="d-flex justify-content-center mt-4">
                        {{ knp_pagination_render(products) }}
                    </div>
                {% endif %}
            {% else %}
                <div class="text-center py-5">
                    <i class="fas fa-search fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">Товары не найдены</h4>
                    <p class="text-muted">Попробуйте изменить параметры поиска или фильтры</p>
                    <a href="{{ path('app_catalog') }}" class="btn btn-primary">
                        <i class="fas fa-list me-2"></i>
                        Показать все товары
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    <style>
        .product-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            cursor: pointer;
        }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        }

        .product-image {
            height: 200px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #f8f9fa;
            position: relative;
        }

        .product-image img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        .featured-badge {
            position: absolute;
            top: 10px;
            left: 10px;
        }

        .product-price .price {
            font-size: 1.25rem;
        }

        .product-price .old-price {
            font-size: 0.9rem;
        }

        .product-actions .btn {
            flex: 1;
        }
    </style>
{% endblock %}

{% block javascripts %}
    <script>
        function addToCart(productId) {
            // Получаем CSRF токен
            const token = '{{ csrf_token('cart_add') }}';

            fetch(`{{ path('app_cart_add', {'id': '__PRODUCT_ID__'}) }}`.replace('__PRODUCT_ID__', productId), {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: 'quantity=1&_token=' + encodeURIComponent(token)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Товар добавлен в корзину!');
                    updateNavigationCounters();
                } else {
                    alert(data.message || 'Ошибка при добавлении в корзину');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Произошла ошибка при добавлении в корзину');
            });
        }

        function toggleWishlist(productId) {
            const token = '{{ csrf_token('wishlist_toggle') }}';

            fetch(`{{ path('app_wishlist_toggle', {'id': '__PRODUCT_ID__'}) }}`.replace('__PRODUCT_ID__', productId), {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: '_token=' + encodeURIComponent(token)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const button = event.target.closest('button');
                    if (data.inWishlist) {
                        button.innerHTML = '<i class="fas fa-heart"></i>';
                        button.classList.remove('btn-outline-danger');
                        button.classList.add('btn-danger');
                    } else {
                        button.innerHTML = '<i class="far fa-heart"></i>';
                        button.classList.remove('btn-danger');
                        button.classList.add('btn-outline-danger');
                    }
                    updateNavigationCounters();
                } else {
                    alert(data.message || 'Ошибка при работе с избранным');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Произошла ошибка при работе с избранным');
            });
        }

        function toggleCompare(productId) {
            const token = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';

            fetch(`{{ path('app_compare_toggle', {'id': '__PRODUCT_ID__'}) }}`.replace('__PRODUCT_ID__', productId), {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: '_token=' + encodeURIComponent(token)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const button = event.target.closest('button');
                    if (data.inCompare) {
                        button.innerHTML = '<i class="fas fa-balance-scale"></i>';
                        button.classList.remove('btn-outline-info');
                        button.classList.add('btn-info');
                    } else {
                        button.innerHTML = '<i class="fas fa-balance-scale"></i>';
                        button.classList.remove('btn-info');
                        button.classList.add('btn-outline-info');
                    }
                    updateNavigationCounters();
                } else {
                    alert(data.message || 'Ошибка при работе со сравнением');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Произошла ошибка при работе со сравнением');
            });
        }

        function updateNavigationCounters() {
            // Обновляем счетчики в навигационной панели
            fetch('{{ path('app_navigation_counters') }}', {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                // Обновляем счетчики корзины, избранного и сравнения
                const cartBadge = document.querySelector('.cart-count');
                const wishlistBadge = document.querySelector('.wishlist-count');
                const compareBadge = document.querySelector('.compare-count');

                if (cartBadge) cartBadge.textContent = data.cartCount;
                if (wishlistBadge) wishlistBadge.textContent = data.wishlistCount;
                if (compareBadge) compareBadge.textContent = data.compareCount;
            })
            .catch(error => {
                console.error('Error updating counters:', error);
            });
        }
    </script>
{% endblock %}
