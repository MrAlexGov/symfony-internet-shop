{% extends 'base.html.twig' %}

{% block title %}Профиль пользователя - Mobile Shop{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-user-circle fa-5x text-primary"></i>
                    </div>
                    <h4>{{ user.getFullName() }}</h4>
                    <p class="text-muted">{{ user.email }}</p>
                    {% if user.phone %}
                        <p class="text-muted">
                            <i class="fas fa-phone me-2"></i>{{ user.phone }}
                        </p>
                    {% endif %}
                    <p class="text-muted">
                        <i class="fas fa-calendar me-2"></i>
                        Зарегистрирован: {{ user.createdAt|date('d.m.Y') }}
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-user-edit me-2"></i>
                        Информация о профиле
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-3">
                            <strong>Имя:</strong>
                        </div>
                        <div class="col-sm-9">
                            {{ user.firstName }}
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-3">
                            <strong>Фамилия:</strong>
                        </div>
                        <div class="col-sm-9">
                            {{ user.lastName }}
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-3">
                            <strong>Email:</strong>
                        </div>
                        <div class="col-sm-9">
                            {{ user.email }}
                        </div>
                    </div>

                    {% if user.phone %}
                        <div class="row mb-3">
                            <div class="col-sm-3">
                                <strong>Телефон:</strong>
                            </div>
                            <div class="col-sm-9">
                                {{ user.phone }}
                            </div>
                        </div>
                    {% endif %}

                    <div class="row mb-3">
                        <div class="col-sm-3">
                            <strong>Статус:</strong>
                        </div>
                        <div class="col-sm-9">
                            {% if user.isVerified %}
                                <span class="badge bg-success">
                                    <i class="fas fa-check-circle me-1"></i>Подтвержден
                                </span>
                            {% else %}
                                <span class="badge bg-warning">
                                    <i class="fas fa-clock me-1"></i>Не подтвержден
                                </span>
                            {% endif %}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-3">
                            <strong>Роль:</strong>
                        </div>
                        <div class="col-sm-9">
                            {% for role in user.roles %}
                                <span class="badge bg-primary">{{ role }}</span>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-shopping-bag me-2"></i>
                        История заказов
                    </h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">История заказов будет доступна после оформления первого заказа.</p>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-heart me-2"></i>
                        Избранное
                    </h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Избранные товары будут отображаться здесь.</p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
