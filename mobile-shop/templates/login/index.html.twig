{% extends 'base.html.twig' %}

{% block title %}Вход в систему - Mobile Shop{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow">
                <div class="card-body p-5">
                    <h2 class="text-center mb-4">
                        <i class="fas fa-sign-in-alt text-primary me-2"></i>
                        Вход в систему
                    </h2>

                    {% if error %}
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        </div>
                    {% endif %}

                    <form method="post" class="needs-validation" novalidate>
                        {% if app.target_path %}
                            <input type="hidden" name="_target_path" value="{{ app.target_path }}">
                        {% endif %}

                        <div class="mb-3">
                            <label for="inputEmail" class="form-label">
                                <i class="fas fa-envelope me-2"></i>Email адрес
                            </label>
                            <input type="email"
                                   value="{{ last_username }}"
                                   name="email"
                                   id="inputEmail"
                                   class="form-control"
                                   autocomplete="email"
                                   required
                                   autofocus>
                            <div class="invalid-feedback">
                                Пожалуйста, введите корректный email адрес.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="inputPassword" class="form-label">
                                <i class="fas fa-lock me-2"></i>Пароль
                            </label>
                            <input type="password"
                                   name="password"
                                   id="inputPassword"
                                   class="form-control"
                                   autocomplete="current-password"
                                   required>
                            <div class="invalid-feedback">
                                Пожалуйста, введите пароль.
                            </div>
                        </div>

                        <div class="mb-3 form-check">
                            <input type="checkbox"
                                   name="_remember_me"
                                   id="rememberMe"
                                   class="form-check-input">
                            <label class="form-check-label" for="rememberMe">
                                Запомнить меня
                            </label>
                        </div>

                        <div class="d-grid">
                            <button class="btn btn-primary btn-lg" type="submit">
                                <i class="fas fa-sign-in-alt me-2"></i>
                                Войти
                            </button>
                        </div>
                    </form>

                    <div class="text-center mt-4">
                        <p>
                            <a href="#" class="text-decoration-none">
                                Забыли пароль?
                            </a>
                        </p>
                        <p>Нет аккаунта?
                            <a href="{{ path('app_registration') }}" class="text-decoration-none">
                                Зарегистрироваться
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
