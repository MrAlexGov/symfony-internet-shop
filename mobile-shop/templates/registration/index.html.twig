{% extends 'base.html.twig' %}

{% block title %}Регистрация - Mobile Shop{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow">
                <div class="card-body p-5">
                    <h2 class="text-center mb-4">
                        <i class="fas fa-user-plus text-primary me-2"></i>
                        Регистрация
                    </h2>

                    {{ form_start(registrationForm, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                {{ form_row(registrationForm.firstName, {
                                    'attr': {'class': 'form-control', 'placeholder': 'Введите имя'},
                                    'label_attr': {'class': 'form-label'}
                                }) }}
                            </div>
                            <div class="col-md-6 mb-3">
                                {{ form_row(registrationForm.lastName, {
                                    'attr': {'class': 'form-control', 'placeholder': 'Введите фамилию'},
                                    'label_attr': {'class': 'form-label'}
                                }) }}
                            </div>
                        </div>

                        <div class="mb-3">
                            {{ form_row(registrationForm.email, {
                                'attr': {'class': 'form-control', 'placeholder': 'Введите email'},
                                'label_attr': {'class': 'form-label'}
                            }) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(registrationForm.phone, {
                                'attr': {'class': 'form-control', 'placeholder': 'Введите телефон (необязательно)'},
                                'label_attr': {'class': 'form-label'}
                            }) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(registrationForm.plainPassword, {
                                'attr': {'class': 'form-control', 'placeholder': 'Введите пароль'},
                                'label_attr': {'class': 'form-label'}
                            }) }}
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-user-plus me-2"></i>
                                Зарегистрироваться
                            </button>
                        </div>
                    {{ form_end(registrationForm) }}

                    <div class="text-center mt-4">
                        <p>Уже есть аккаунт?
                            <a href="{{ path('app_login') }}" class="text-decoration-none">
                                Войти в систему
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
