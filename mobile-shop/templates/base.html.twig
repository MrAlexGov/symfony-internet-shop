<!DOCTYPE html>
<html lang="ru">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="csrf-token" content="{{ csrf_token('cart_add') }}">
        <title>{% block title %}Mobile Shop - Интернет-магазин мобильных телефонов{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>📱</text></svg>">

        <!-- Bootstrap CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

        <!-- Font Awesome -->
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <!-- Навигационная панель -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" href="{{ path('app_home') }}">
                    <i class="fas fa-mobile-alt me-2"></i>Mobile Shop
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_home') }}">Главная</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_catalog') }}">Каталог</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#about">О нас</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#contacts">Контакты</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav">
                        {% if app.user %}
                            <!-- Корзина -->
                            <li class="nav-item me-3">
                                <a class="nav-link position-relative d-flex align-items-center" href="{{ path('app_cart') }}">
                                    <i class="fas fa-shopping-cart me-1"></i>
                                    <span>Корзина</span>
                                    {% if app.user.cart and not app.user.cart.isEmpty %}
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                            {{ app.user.cart.totalItems }}
                                        </span>
                                    {% endif %}
                                </a>
                            </li>

                            <!-- Избранное -->
                            <li class="nav-item me-3">
                                <a class="nav-link position-relative d-flex align-items-center" href="{{ path('app_wishlist') }}">
                                    <i class="fas fa-heart me-1"></i>
                                    <span>Избранное</span>
                                    {% if app.user.wishlist and not app.user.wishlist.isEmpty %}
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                            {{ app.user.wishlist.totalItems }}
                                        </span>
                                    {% endif %}
                                </a>
                            </li>

                            <!-- Сравнение -->
                            <li class="nav-item me-3">
                                <a class="nav-link position-relative d-flex align-items-center" href="{{ path('app_compare') }}">
                                    <i class="fas fa-balance-scale me-1"></i>
                                    <span>Сравнение</span>
                                    {% if app.user.compare and not app.user.compare.isEmpty %}
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                            {{ app.user.compare.totalItems }}
                                        </span>
                                    {% endif %}
                                </a>
                            </li>
                        {% endif %}
                    </ul>

                    <ul class="navbar-nav">
                        {% if app.user %}
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-user me-1"></i>{{ app.user.firstName ?? app.user.email }}
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="{{ path('app_profile') }}">
                                        <i class="fas fa-user-circle me-2"></i>Профиль
                                    </a></li>
                                    <li><a class="dropdown-item" href="{{ path('app_logout') }}">
                                        <i class="fas fa-sign-out-alt me-2"></i>Выйти
                                    </a></li>
                                </ul>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_login') }}">
                                    <i class="fas fa-sign-in-alt me-1"></i>Войти
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary ms-2" href="{{ path('app_registration') }}">
                                    Регистрация
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Основной контент -->
        <main class="container my-4">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <!-- Футер -->
        <footer class="bg-dark text-light mt-5 py-4">
            <div class="container">
                <div class="row">
                    <div class="col-md-4">
                        <h5>Mobile Shop</h5>
                        <p>Лучший интернет-магазин мобильных телефонов и аксессуаров</p>
                        <div class="mt-3">
                            <a href="{{ path('app_cart') }}" class="text-light me-3">
                                <i class="fas fa-shopping-cart me-1"></i>Корзина
                            </a>
                            <a href="{{ path('app_wishlist') }}" class="text-light me-3">
                                <i class="fas fa-heart me-1"></i>Избранное
                            </a>
                            <a href="{{ path('app_compare') }}" class="text-light">
                                <i class="fas fa-balance-scale me-1"></i>Сравнение
                            </a>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <h5>Навигация</h5>
                        <ul class="list-unstyled">
                            <li><a href="{{ path('app_home') }}" class="text-light">Главная</a></li>
                            <li><a href="{{ path('app_catalog') }}" class="text-light">Каталог товаров</a></li>
                            <li><a href="#about" class="text-light">О нас</a></li>
                            <li><a href="#contacts" class="text-light">Контакты</a></li>
                        </ul>
                    </div>
                    <div class="col-md-4">
                        <h5>Контакты</h5>
                        <p><i class="fas fa-envelope me-2"></i>Email: info@mobilshop.ru</p>
                        <p><i class="fas fa-phone me-2"></i>Телефон: +7 (495) 123-45-67</p>
                        <p><i class="fas fa-clock me-2"></i>Режим работы: 9:00 - 21:00</p>
                    </div>
                </div>
                <hr class="my-4">
                <div class="row">
                    <div class="col-12 text-center">
                        <small>&copy; 2025 Mobile Shop. Все права защищены.</small>
                    </div>
                </div>
            </div>
        </footer>

        <!-- Bootstrap JS -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

        {% block javascripts_bottom %}{% endblock %}
    </body>
</html>
